+from __future__ import annotations
+
+from copy import deepcopy
+from pathlib import Path
+import sys
+
+sys.path.insert(0, str(Path(__file__).resolve().parents[1]))
+
+from game.balance import balance_controller
+from game.balance import combined_mode, passive_mode, weakness_mode
+from game.combat.damage_engine import calculate_damage
+
+
+FIGHTER_TEMPLATE = {
+    "display_name": "Fighter",
+    "maxHP": 25,
+    "curHP": 25,
+    "movement": 3,
+    "actions": [{"damage": 5}, {"damage": 6}, {"damage": 6}],
+}
+WIZARD_TEMPLATE = {
+    "display_name": "Wizard",
+    "maxHP": 28,
+    "curHP": 28,
+    "movement": 3,
+    "actions": [{"damage": 5}, {"damage": 8}, {"damage": 6}],
+}
+ASSASSIN_TEMPLATE = {
+    "display_name": "Assassin",
+    "maxHP": 22,
+    "curHP": 22,
+    "movement": 4,
+    "actions": [{"damage": 10}, {"damage": 5}],
+}
+
+
+def test_baseline_mode_loads_by_default_when_none_passed():
+    balance_controller.load_balance_mode(None)
+    assert balance_controller.get_active_mode() == balance_controller.BASELINE
+
+
+def test_each_mode_loads_correctly():
+    for mode in (
+        balance_controller.BASELINE,
+        balance_controller.PASSIVE,
+        balance_controller.WEAKNESS,
+        balance_controller.COMBINED,
+    ):
+        balance_controller.load_balance_mode(mode)
+        assert balance_controller.get_active_mode() == mode
+
+
+def test_baseline_stat_normalization_hp_values():
+    balance_controller.load_balance_mode(balance_controller.BASELINE)
+
+    fighter = balance_controller.adjust_template_stats(deepcopy(FIGHTER_TEMPLATE))
+    wizard = balance_controller.adjust_template_stats(deepcopy(WIZARD_TEMPLATE))
+    assassin = balance_controller.adjust_template_stats(deepcopy(ASSASSIN_TEMPLATE))
+
+    assert fighter["maxHP"] == 26
+    assert wizard["maxHP"] == 27
+    assert assassin["maxHP"] == 22
+
+
+def test_passive_score_calculations():
+    assert passive_mode.passive_score(FIGHTER_TEMPLATE) == 3.42
+    assert passive_mode.passive_score(WIZARD_TEMPLATE) == 4.8
+    assert passive_mode.passive_score(ASSASSIN_TEMPLATE) == 3.9
+
+
+def test_weakness_multipliers_apply_correctly():
+    base_damage = 10
+
+    fighter_vs_assassin = weakness_mode.calculate_damage(base_damage, "fighter", "assassin")
+    wizard_vs_fighter = weakness_mode.calculate_damage(base_damage, "wizard", "fighter")
+    assassin_vs_fighter = weakness_mode.calculate_damage(base_damage, "assassin", "fighter")
+
+    assert fighter_vs_assassin == base_damage * 1.2
+    assert wizard_vs_fighter == base_damage * 1.2
+    assert assassin_vs_fighter == base_damage * 0.8
+
+
+def test_combined_mode_integrates_all_modifiers():
+    base_damage = 10
+    final_power = combined_mode.final_power(
+        template=FIGHTER_TEMPLATE,
+        attacker_class="fighter",
+        defender_class="assassin",
+        base_damage=base_damage,
+        terrain_type="ObjectiveTile",
+    )
+
+    # Base(39.67) + Passive(3.42) + WeaknessScore(12.0) + Terrain(2)
+    assert round(final_power, 2) == 57.09
+
+    balance_controller.load_balance_mode(balance_controller.COMBINED)
+    dmg = calculate_damage(base_damage, "fighter", "assassin", "ObjectiveTile")
+    assert dmg == 14.0
 
EOF
)