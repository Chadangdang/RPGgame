+import unittest
+
+from game.session_limits import SessionProgress, apply_match_result
+
+
+class SessionLimitTests(unittest.TestCase):
+    def make_state(self):
+        return SessionProgress(
+            current_game=1,
+            current_match=1,
+            match_limit=3,
+            game_limit=2,
+            game_p1_match_wins=0,
+            game_p2_match_wins=0,
+            total_games_p1=0,
+            total_games_p2=0,
+            total_p1_win=0,
+            total_p2_win=0,
+        )
+
+    def test_match_limit_stops_matches_within_game(self):
+        state = self.make_state()
+        state.current_match = 3
+        result = apply_match_result(state, 'P1')
+        self.assertTrue(result['game_finished'])
+        self.assertEqual(state.current_match, 0)
+        self.assertEqual(state.current_game, 2)
+
+    def test_game_winner_determined_by_match_wins(self):
+        state = self.make_state()
+        state.current_match = 3
+        state.game_p1_match_wins = 2
+        result = apply_match_result(state, 'P2')
+        self.assertEqual(result['game_winner'], 'P1')
+        self.assertEqual(state.total_games_p1, 1)
+
+    def test_game_limit_stops_total_games(self):
+        state = self.make_state()
+        state.current_game = 2
+        state.current_match = 3
+        state.game_p1_match_wins = 2
+        result = apply_match_result(state, 'P1')
+        self.assertTrue(result['session_finished'])
+
+    def test_session_winner_counts_games(self):
+        state = self.make_state()
+        state.current_match = 3
+        state.game_p1_match_wins = 2
+        apply_match_result(state, 'P1')
+
+        state.current_game = 2
+        state.current_match = 3
+        state.game_p1_match_wins = 0
+        state.game_p2_match_wins = 2
+        apply_match_result(state, 'P2')
+
+        self.assertEqual(state.total_games_p1, 1)
+        self.assertEqual(state.total_games_p2, 1)
+
+
+if __name__ == '__main__':
+    unittest.main()
 
EOF
